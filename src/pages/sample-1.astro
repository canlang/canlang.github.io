---
import Layout from "../layouts/Layout.astro";
import { cv } from "../data/cv";

const highlightAuthor = (authors: string[]) =>
  authors
    .map((author) => (author.includes(cv.name) ? `<strong class="me">${author}</strong>` : author))
    .join(", ");
---

<Layout title={`${cv.name} | Academic Scholar (Sample 1)`} description={cv.intro}>
  <div class="sample-banner">
    <span>💡 <strong>Sample 1</strong>: 학술 정통 미니멀리즘 (Jon Barron / Editorial Paper Style)</span>
    <div class="banner-links">
      <a href="/sample-1" class="active">Sample 1</a>
      <a href="/sample-2">Sample 2 (Dark-Tech)</a>
      <a href="/sample-3">Sample 3 (Split-Pane)</a>
      <a href="/">Current Main</a>
    </div>
  </div>

  <div class="academic-page">
    <!-- Masthead: Simple editorial header with right-floated avatar -->
    <header class="masthead">
      <div class="bio-main">
        <h1 class="name">{cv.name} <span class="ko-name">이상재</span></h1>
        <p class="title">{cv.title}</p>
        <p class="affiliation">KAIST Ph.D. in Computer Science · Staff Engineer at Samsung Research</p>
        
        <p class="summary-paragraph">
          {cv.intro}
        </p>

        <div class="inline-links">
          <a href={`mailto:${cv.email}`}>Email</a>
          <span class="sep">/</span>
          <a href="/sangjae-lee-pro-academic-cv.pdf" target="_blank">CV (PDF)</a>
          <span class="sep">/</span>
          <a href={cv.github} target="_blank">GitHub</a>
          <span class="sep">/</span>
          <a href={cv.linkedin} target="_blank">LinkedIn</a>
          <span class="sep">/</span>
          <span>{cv.location}</span>
        </div>
      </div>
      <div class="avatar-box">
        <img src="/avatar2.jpg" alt={cv.name} class="avatar" />
      </div>
    </header>

    <!-- Research Focus -->
    <section class="section">
      <h2 class="section-title">Research Focus</h2>
      <p class="prose">
        {cv.profile}
      </p>
      <div class="tag-row">
        {cv.interests.map((tag) => (
          <span class="paper-tag">{tag}</span>
        ))}
      </div>
    </section>

    <!-- Publications -->
    <section class="section">
      <h2 class="section-title">Publications</h2>
      <p class="section-sub">Selected peer-reviewed articles in wireless sensing, indoor localization, and sensor fusion.</p>
      
      <ol class="pub-list">
        {cv.publications.map((paper) => (
          <li class="pub-item">
            <div class="pub-main">
              <span class="pub-title">
                <a href={paper.url} target="_blank" rel="noreferrer">
                  {paper.title}
                </a>
              </span>
              <div class="pub-authors" set:html={highlightAuthor(paper.authors)} />
              <div class="pub-venue">
                <em>{paper.venue}</em>, {paper.year}
                <span class="pub-links">
                  [<a href={paper.url} target="_blank">DOI</a>]
                  {paper.bibtex && (
                    <button class="text-btn bib-btn" data-bib={paper.bibtex}>[BibTeX]</button>
                  )}
                </span>
              </div>
              <div class="bib-box hidden">
                <pre><code>{paper.bibtex}</code></pre>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Experience -->
    <section class="section">
      <h2 class="section-title">Experience</h2>
      {cv.experience.map((job) => (
        <div class="exp-item">
          <div class="exp-header">
            <strong>{job.company}</strong> — <span class="role">{job.role}</span>
            <span class="period">{job.period}</span>
          </div>
          <p class="exp-summary">{job.summary}</p>
          <ul class="exp-bullets">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <!-- Sponsored Grants -->
    <section class="section">
      <h2 class="section-title">Selected Sponsored R&D</h2>
      <div class="grant-list">
        {cv.sponsoredResearch.featured.map((grant) => (
          <div class="grant-item">
            <div class="grant-head">
              <span class="grant-title">{grant.title}</span>
              <span class="grant-meta">{grant.sponsor} ({grant.period})</span>
            </div>
            <p class="grant-desc">{grant.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="section">
      <h2 class="section-title">Education</h2>
      <div class="edu-grid">
        {cv.education.map((edu) => (
          <div class="edu-item">
            <div class="edu-deg"><strong>{edu.school}</strong> · {edu.degree}</div>
            <div class="edu-meta">{edu.period} {edu.detail ? `· ${edu.detail}` : ""}</div>
            <div class="edu-focus">{edu.focus}</div>
          </div>
        ))}
      </div>
    </section>

    <footer class="academic-footer">
      <p>© {new Date().getFullYear()} {cv.name}. Typeset in classic academic editorial format.</p>
    </footer>
  </div>
</Layout>

<script>
  document.querySelectorAll(".bib-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const parent = btn.closest(".pub-item");
      const box = parent?.querySelector(".bib-box");
      box?.classList.toggle("hidden");
    });
  });
</script>

<style>
  /* Sample Switcher Banner */
  .sample-banner {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #1e293b;
    color: #f8fafc;
    padding: 0.65rem 1.5rem;
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #334155;
  }
  .banner-links {
    display: flex;
    gap: 0.75rem;
  }
  .banner-links a {
    color: #94a3b8;
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }
  .banner-links a:hover,
  .banner-links a.active {
    background: #0ea5e9;
    color: #fff;
  }

  /* Academic Page: Pure Whitespace & Editorial Typography */
  .academic-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: #222222;
    line-height: 1.65;
    font-size: 15.5px;
  }

  /* Masthead */
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #eaeaea;
    margin-bottom: 2.5rem;
  }
  .bio-main {
    flex: 1;
  }
  .name {
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111;
    margin-bottom: 0.2rem;
  }
  .ko-name {
    font-size: 1.15rem;
    font-weight: 400;
    color: #777;
  }
  .title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #444;
    margin-bottom: 0.15rem;
  }
  .affiliation {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1rem;
  }
  .summary-paragraph {
    color: #333;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .inline-links {
    font-size: 0.9rem;
    color: #555;
  }
  .inline-links a {
    color: #0366d6;
    text-decoration: none;
  }
  .inline-links a:hover {
    text-decoration: underline;
  }
  .sep {
    margin: 0 0.35rem;
    color: #aaa;
  }
  .avatar-box {
    flex-shrink: 0;
  }
  .avatar {
    width: 145px;
    height: 145px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    border: 3px solid #fff;
  }

  /* Sections */
  .section {
    margin-bottom: 3rem;
  }
  .section-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #111;
    border-bottom: 1.5px solid #222;
    padding-bottom: 0.4rem;
    margin-bottom: 1.25rem;
    text-transform: capitalize;
  }
  .section-sub {
    font-size: 0.9rem;
    color: #666;
    margin-top: -0.5rem;
    margin-bottom: 1.25rem;
  }
  .prose {
    color: #333;
    line-height: 1.65;
    margin-bottom: 1rem;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .paper-tag {
    background: #f3f4f6;
    color: #4b5563;
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
  }

  /* Publications: Clean Numbered List */
  .pub-list {
    padding-left: 1.25rem;
  }
  .pub-item {
    margin-bottom: 1.5rem;
    padding-left: 0.35rem;
  }
  .pub-title a {
    font-size: 1.025rem;
    font-weight: 600;
    color: #0366d6;
    text-decoration: none;
    line-height: 1.45;
  }
  .pub-title a:hover {
    text-decoration: underline;
  }
  .pub-authors {
    font-size: 0.9rem;
    color: #444;
    margin: 0.2rem 0;
  }
  :global(.pub-authors .me) {
    color: #000;
    font-weight: 700;
  }
  .pub-venue {
    font-size: 0.85rem;
    color: #555;
  }
  .pub-links {
    margin-left: 0.5rem;
  }
  .pub-links a {
    color: #0366d6;
    text-decoration: none;
  }
  .text-btn {
    background: none;
    border: none;
    color: #0366d6;
    cursor: pointer;
    font-size: inherit;
    padding: 0;
  }
  .text-btn:hover {
    text-decoration: underline;
  }
  .bib-box {
    margin-top: 0.5rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 0.75rem;
    border-radius: 4px;
  }
  .bib-box.hidden {
    display: none;
  }
  .bib-box pre {
    margin: 0;
    font-family: monospace;
    font-size: 0.75rem;
    color: #334155;
    overflow-x: auto;
  }

  /* Experience */
  .exp-item {
    margin-bottom: 1.75rem;
  }
  .exp-header {
    font-size: 1.05rem;
    color: #111;
    margin-bottom: 0.35rem;
  }
  .exp-header .role {
    font-weight: 500;
    color: #333;
  }
  .exp-header .period {
    float: right;
    font-size: 0.85rem;
    color: #777;
    font-family: monospace;
  }
  .exp-summary {
    font-size: 0.925rem;
    color: #444;
    margin-bottom: 0.5rem;
  }
  .exp-bullets {
    padding-left: 1.25rem;
    font-size: 0.885rem;
    color: #444;
    line-height: 1.6;
  }
  .exp-bullets li {
    margin-bottom: 0.25rem;
  }

  /* Grants */
  .grant-item {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed #eaeaea;
  }
  .grant-item:last-child {
    border-bottom: none;
  }
  .grant-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }
  .grant-title {
    font-weight: 600;
    color: #111;
  }
  .grant-meta {
    font-size: 0.85rem;
    color: #666;
    font-family: monospace;
  }
  .grant-desc {
    font-size: 0.885rem;
    color: #444;
  }

  /* Education */
  .edu-item {
    margin-bottom: 1rem;
  }
  .edu-deg {
    font-size: 0.95rem;
    color: #111;
  }
  .edu-meta {
    font-size: 0.825rem;
    color: #666;
    font-family: monospace;
  }
  .edu-focus {
    font-size: 0.85rem;
    color: #444;
  }

  .academic-footer {
    border-top: 1px solid #eaeaea;
    padding-top: 2rem;
    font-size: 0.825rem;
    color: #888;
    text-align: center;
  }

  @media (max-width: 680px) {
    .masthead {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }
    .exp-header .period {
      float: none;
      display: block;
      margin-top: 0.2rem;
    }
    .grant-head {
      flex-direction: column;
    }
  }
</style>
