---
import Layout from "../layouts/Layout.astro";
import { cv } from "../data/cv";

const firstAuthor = cv.name;

const highlightAuthor = (authors: string[]) =>
  authors
    .map((author) => (author.includes(firstAuthor) ? `<strong>${author}</strong>` : author))
    .join(", ");

const journalCount = cv.publications.filter((p) => p.type === "Journal").length;
const confCount = cv.publications.filter((p) => p.type === "Conference").length;
---

<Layout title={`${cv.name} | Staff Engineer & Ph.D.`} description={cv.intro}>
  <!-- Toast Notification Container -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <main class="page">
    <!-- Masthead & Identity -->
    <header class="masthead">
      <div class="masthead-main">
        <div class="avatar-wrap">
          <img src="/avatar2.jpg" alt={cv.name} class="avatar-img" />
          <span class="status-indicator" title="Available for academic/research collaborations"></span>
        </div>
        <div class="identity">
          <div class="identity-top">
            <span class="badge-role">Academic CV & Engineering Portfolio</span>
            <div class="theme-control-mobile">
              <button id="theme-toggle-mobile" class="icon-btn" title="Toggle theme" aria-label="Toggle dark/light theme">
                <span class="theme-icon">🌓</span>
              </button>
            </div>
          </div>
          <h1>{cv.name} <span class="korean-name">이상재</span></h1>
          <p class="role-title">{cv.title}</p>
          <p class="headline">{cv.headline}</p>

          <div class="domain-tags">
            {cv.interests.map((interest) => (
              <span class="tag">{interest}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Action Toolbar -->
      <div class="toolbar">
        <div class="contact-links">
          <button id="copy-email-btn" class="btn btn-primary" data-email={cv.email}>
            <span class="btn-icon">✉️</span> Copy Email
          </button>
          <a href="/sangjae-lee-pro-academic-cv.pdf" target="_blank" rel="noreferrer" class="btn btn-secondary">
            <span class="btn-icon">📄</span> PDF CV
          </a>
          <a href={cv.github} target="_blank" rel="noreferrer" class="btn btn-ghost" title="GitHub Profile">
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a href={cv.linkedin} target="_blank" rel="noreferrer" class="btn btn-ghost" title="LinkedIn Profile">
            <svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>
        </div>

        <div class="toolbar-right">
          <span class="meta-location">📍 {cv.location}</span>
          <button id="theme-toggle" class="icon-btn desktop-only" title="Toggle theme (Light / Dark)" aria-label="Toggle dark/light theme">
            <span class="theme-icon">🌓</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Metrics Strip -->
    <section class="metrics-grid">
      {cv.metrics.map((metric) => (
        <div class="metric-card">
          <strong class="metric-value">{metric.value}</strong>
          <span class="metric-label">{metric.label}</span>
        </div>
      ))}
    </section>

    <!-- Bio & Summary -->
    <section class="card intro-card">
      <h2 class="card-title">Executive Summary</h2>
      <p class="lead-text">{cv.intro}</p>
      <p class="secondary-text">{cv.profile}</p>
    </section>

    <!-- Main 2-Column Content Layout -->
    <div class="content-layout">
      <!-- Left Column (Primary Focus: Experience, Publications, Systems) -->
      <div class="main-column">
        <!-- Publications Section -->
        <section class="card section-card">
          <div class="section-header">
            <div>
              <p class="section-tag">Scholarship</p>
              <h2 class="card-title">Peer-Reviewed Publications</h2>
            </div>
            <!-- Filter Tabs -->
            <div class="filter-tabs" role="tablist">
              <button class="filter-tab active" data-filter="all">All ({cv.publications.length})</button>
              <button class="filter-tab" data-filter="Journal">Journals ({journalCount})</button>
              <button class="filter-tab" data-filter="Conference">Conferences ({confCount})</button>
            </div>
          </div>

          <div class="publications-list" id="publications-container">
            {cv.publications.map((paper) => (
              <article class="paper-item" data-type={paper.type}>
                <div class="paper-header">
                  <div class="paper-meta">
                    <span class={`type-badge badge-${paper.type.toLowerCase()}`}>{paper.type}</span>
                    <span class="paper-year">{paper.year}</span>
                    <span class="paper-venue">{paper.venue}</span>
                  </div>
                </div>

                <h3 class="paper-title">
                  <a href={paper.url} target="_blank" rel="noreferrer">
                    {paper.title}
                  </a>
                </h3>

                <p class="paper-authors" set:html={highlightAuthor(paper.authors)} />

                <div class="paper-actions">
                  <a href={paper.url} target="_blank" rel="noreferrer" class="action-link">
                    DOI / Paper ↗
                  </a>
                  {paper.bibtex && (
                    <button class="action-link bibtex-btn" type="button" aria-expanded="false">
                      BibTeX ▼
                    </button>
                  )}
                </div>

                {paper.bibtex && (
                  <div class="bibtex-drawer hidden">
                    <div class="bibtex-bar">
                      <span>BibTeX</span>
                      <button class="copy-bibtex-btn" data-bibtex={paper.bibtex}>
                        Copy BibTeX
                      </button>
                    </div>
                    <pre><code>{paper.bibtex}</code></pre>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>

        <!-- Professional Experience -->
        <section class="card section-card">
          <div class="section-header">
            <div>
              <p class="section-tag">Industry Experience</p>
              <h2 class="card-title">Professional Experience</h2>
            </div>
          </div>

          <div class="timeline">
            {cv.experience.map((job) => (
              <article class="timeline-entry">
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                  <div class="timeline-head">
                    <div>
                      <h3 class="job-role">{job.role}</h3>
                      <p class="job-company">{job.company}</p>
                    </div>
                    <span class="timeline-period">{job.period}</span>
                  </div>
                  <p class="job-summary">{job.summary}</p>
                  <ul class="job-bullets">
                    {job.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Sponsored Research & Platforms -->
        <section class="card section-card">
          <div class="section-header">
            <div>
              <p class="section-tag">Grants & Deployment</p>
              <h2 class="card-title">Sponsored R&D & Systems</h2>
            </div>
          </div>

          <div class="grant-grid">
            {cv.sponsoredResearch.featured.map((grant) => (
              <article class="grant-card">
                <div class="grant-top">
                  <span class="grant-sponsor">{grant.sponsor}</span>
                  <span class="grant-period">{grant.period}</span>
                </div>
                <h3 class="grant-title">
                  {grant.url ? (
                    <a href={grant.url} target="_blank" rel="noreferrer">
                      {grant.title} ↗
                    </a>
                  ) : (
                    grant.title
                  )}
                </h3>
                <p class="grant-role">{grant.role}</p>
                <p class="grant-desc">{grant.description}</p>
              </article>
            ))}
          </div>

          <div class="additional-grants">
            <h4 class="subhead">Additional Sponsored Projects</h4>
            <ul class="simple-list">
              {cv.sponsoredResearch.additional.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span class="muted"> — {item.sponsor} ({item.period})</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>

      <!-- Right Column (Sidebar: Education, Strengths, Skills) -->
      <aside class="side-column">
        <!-- Education -->
        <section class="card side-card">
          <h2 class="card-title">Education</h2>
          <div class="edu-list">
            {cv.education.map((edu) => (
              <div class="edu-item">
                <div class="edu-head">
                  <h3 class="edu-degree">{edu.degree}</h3>
                  <span class="edu-period">{edu.period}</span>
                </div>
                <p class="edu-school">{edu.school}</p>
                {edu.detail && <p class="edu-advisor">{edu.detail}</p>}
                <p class="edu-focus">{edu.focus}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Technical Strengths -->
        <section class="card side-card">
          <h2 class="card-title">Core Competencies</h2>
          <div class="strengths-list">
            {cv.strengths.map((str) => (
              <div class="strength-item">
                <h3 class="strength-title">{str.title}</h3>
                <p class="strength-desc">{str.detail}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Technical Skills -->
        <section class="card side-card">
          <h2 class="card-title">Skills & Tooling</h2>
          <div class="skills-groups">
            {cv.skills.map((skillGroup) => (
              <div class="skill-group">
                <h3 class="skill-label">{skillGroup.label}</h3>
                <div class="skill-pills">
                  {skillGroup.items.map((skill) => (
                    <span class="skill-pill">{skill}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Contact & Direct Coordinates -->
        <section class="card side-card">
          <h2 class="card-title">Direct Inquiries</h2>
          <div class="contact-box">
            <div class="contact-row">
              <span class="c-label">Primary</span>
              <a href={`mailto:${cv.email}`} class="c-link">{cv.email}</a>
            </div>
            <div class="contact-row">
              <span class="c-label">Academic</span>
              <a href={`mailto:${cv.secondaryEmail}`} class="c-link">{cv.secondaryEmail}</a>
            </div>
            <div class="contact-row">
              <span class="c-label">Phone</span>
              <span class="c-val">{cv.phone}</span>
            </div>
            <div class="contact-row">
              <span class="c-label">Location</span>
              <span class="c-val">{cv.location}</span>
            </div>
          </div>
        </section>
      </aside>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <p>© {new Date().getFullYear()} {cv.name}. Built with Astro & TypeScript. Hosted on GitHub Pages.</p>
      <p class="footer-links">
        <a href={cv.github} target="_blank" rel="noreferrer">GitHub</a> · 
        <a href={cv.linkedin} target="_blank" rel="noreferrer">LinkedIn</a> · 
        <a href="/sangjae-lee-pro-academic-cv.pdf" target="_blank" rel="noreferrer">Download Printable PDF</a>
      </p>
    </footer>
  </main>
</Layout>

<script>
  // Theme Toggle Logic
  const themeToggle = document.getElementById("theme-toggle");
  const themeToggleMobile = document.getElementById("theme-toggle-mobile");

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    showToast(`Switched to ${isDark ? "Dark" : "Light"} mode`);
  }

  themeToggle?.addEventListener("click", toggleTheme);
  themeToggleMobile?.addEventListener("click", toggleTheme);

  // Toast Functionality
  function showToast(message: string) {
    const toast = document.getElementById("toast");
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add("show");
    setTimeout(() => {
      toast.classList.remove("show");
    }, 2800);
  }

  // Copy Email Button
  const copyEmailBtn = document.getElementById("copy-email-btn");
  copyEmailBtn?.addEventListener("click", () => {
    const email = copyEmailBtn.getAttribute("data-email") || "research@studiosjlee.com";
    navigator.clipboard.writeText(email).then(() => {
      showToast(`Copied to clipboard: ${email}`);
    });
  });

  // Publication Filter Tabs
  const filterTabs = document.querySelectorAll(".filter-tab");
  const paperItems = document.querySelectorAll<HTMLElement>(".paper-item");

  filterTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      filterTabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");

      const filter = tab.getAttribute("data-filter");

      paperItems.forEach((item) => {
        const itemType = item.getAttribute("data-type");
        if (filter === "all" || itemType === filter) {
          item.style.display = "block";
        } else {
          item.style.display = "none";
        }
      });
    });
  });

  // BibTeX Drawer Toggles & Copy
  document.querySelectorAll(".bibtex-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const parent = btn.closest(".paper-item");
      const drawer = parent?.querySelector(".bibtex-drawer");
      if (drawer) {
        const isHidden = drawer.classList.toggle("hidden");
        btn.setAttribute("aria-expanded", (!isHidden).toString());
        btn.textContent = isHidden ? "BibTeX ▼" : "BibTeX ▲";
      }
    });
  });

  document.querySelectorAll(".copy-bibtex-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const bibtex = btn.getAttribute("data-bibtex") || "";
      navigator.clipboard.writeText(bibtex).then(() => {
        showToast("BibTeX copied to clipboard!");
      });
    });
  });
</script>

<style>
  /* Design Tokens & CSS Variables */
  :root {
    --bg-page: #f8fafc;
    --bg-card: #ffffff;
    --bg-card-subtle: #f1f5f9;
    --border-color: #e2e8f0;
    --border-focus: #cbd5e1;
    
    --text-primary: #0f172a;
    --text-secondary: #334155;
    --text-muted: #64748b;
    --text-accent: #0284c7;

    --brand-primary: #0284c7;
    --brand-primary-hover: #0369a1;
    --brand-tint: #e0f2fe;

    --badge-journal-bg: #e0f2fe;
    --badge-journal-color: #0369a1;
    --badge-conf-bg: #fef3c7;
    --badge-conf-color: #92400e;

    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-pill: 9999px;

    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.07);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.08);

    --page-max-width: 1140px;
  }

  /* Dark Theme */
  :global(.dark) {
    --bg-page: #090d16;
    --bg-card: #111827;
    --bg-card-subtle: #1f2937;
    --border-color: #1f2937;
    --border-focus: #374151;

    --text-primary: #f9fafb;
    --text-secondary: #d1d5db;
    --text-muted: #9ca3af;
    --text-accent: #38bdf8;

    --brand-primary: #38bdf8;
    --brand-primary-hover: #7dd3fc;
    --brand-tint: rgba(56, 189, 248, 0.12);

    --badge-journal-bg: rgba(56, 189, 248, 0.15);
    --badge-journal-color: #7dd3fc;
    --badge-conf-bg: rgba(251, 191, 36, 0.15);
    --badge-conf-color: #fcd34d;

    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.5);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.5);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.6);
  }

  /* Base Reset & Layout */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :global(body) {
    background-color: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .page {
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  /* Toast Notification */
  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background-color: var(--text-primary);
    color: var(--bg-page);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(1rem);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 9999;
  }

  .toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* Masthead & Identity */
  .masthead {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .masthead-main {
    display: flex;
    gap: 2.25rem;
    align-items: flex-start;
  }

  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .avatar-img {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 3px solid var(--border-color);
    box-shadow: var(--shadow-md);
  }

  .status-indicator {
    position: absolute;
    bottom: 4px;
    right: 4px;
    width: 16px;
    height: 16px;
    background-color: #10b981;
    border: 3px solid var(--bg-card);
    border-radius: 50%;
  }

  .identity {
    flex: 1;
  }

  .identity-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .badge-role {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--brand-primary);
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .korean-name {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-left: 0.5rem;
  }

  .role-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }

  .headline {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .domain-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.775rem;
    font-weight: 500;
    background-color: var(--bg-card-subtle);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
  }

  /* Toolbar */
  .toolbar {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .meta-location {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background-color: var(--brand-primary);
    color: #ffffff;
  }
  .btn-primary:hover {
    background-color: var(--brand-primary-hover);
  }

  .btn-secondary {
    background-color: var(--brand-tint);
    color: var(--brand-primary);
    border-color: var(--brand-primary);
  }
  .btn-secondary:hover {
    background-color: var(--brand-primary);
    color: #ffffff;
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--text-secondary);
    border-color: var(--border-color);
  }
  .btn-ghost:hover {
    background-color: var(--bg-card-subtle);
    color: var(--text-primary);
    border-color: var(--border-focus);
  }

  .icon-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.15s ease;
