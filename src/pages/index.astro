---
import Layout from "../layouts/Layout.astro";
import { cv } from "../data/cv";

const highlightAuthor = (authors: string[]) =>
  authors
    .map((author) => (author.includes(cv.name) ? `<strong class="author-highlight">${author}</strong>` : author))
    .join(", ");
---

<Layout title={`${cv.name} | Staff Engineer & Ph.D.`} description={cv.intro}>
  <!-- Toast Notification -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <main class="page-container">
    <!-- Top Utility Bar: Theme Toggle & Quick Status -->
    <div class="top-bar">
      <div class="status-pill">
        <span class="pulse-dot"></span>
        <span class="status-text">Staff Engineer @ Samsung Research · Ph.D. (KAIST)</span>
      </div>
      <button id="theme-toggle-btn" class="theme-toggle" title="Toggle Light / Dark mode" aria-label="Toggle theme">
        <span class="theme-icon">🌓</span>
        <span class="theme-label">Theme</span>
      </button>
    </div>

    <!-- Masthead: Academic Identity with Right-side Avatar -->
    <header class="masthead">
      <div class="masthead-bio">
        <h1 class="name">
          {cv.name} <span class="ko-name">이상재</span>
        </h1>
        <p class="role-affiliation">
          {cv.title} · Ph.D. in Computer Science
        </p>
        <p class="headline-summary">
          {cv.headline}
        </p>

        <p class="intro-prose">
          {cv.intro}
        </p>

        <!-- Action Links Toolbar -->
        <div class="quick-links">
          <button id="copy-email-btn" class="link-btn primary" data-email={cv.email}>
            ✉️ {cv.email}
          </button>
          <a href="/sangjae-lee-pro-academic-cv.pdf" target="_blank" rel="noreferrer" class="link-btn">
            📄 CV (PDF) ↗
          </a>
          <a href={cv.github} target="_blank" rel="noreferrer" class="link-btn">
            GitHub ↗
          </a>
          <a href={cv.linkedin} target="_blank" rel="noreferrer" class="link-btn">
            LinkedIn ↗
          </a>
          <span class="location-tag">📍 {cv.location}</span>
        </div>
      </div>

      <div class="avatar-area">
        <img src="/avatar2.jpg" alt={cv.name} class="avatar-photo" />
      </div>
    </header>

    <!-- Compact Key Metrics Strip -->
    <section class="metrics-strip">
      {cv.metrics.map((metric) => (
        <div class="metric-item">
          <span class="metric-value">{metric.value}</span>
          <span class="metric-label">{metric.label}</span>
        </div>
      ))}
    </section>

    <!-- Research Focus & Domains -->
    <section class="content-section">
      <h2 class="section-heading">Research Focus</h2>
      <p class="prose-text">
        {cv.profile}
      </p>
      <div class="tags-container">
        {cv.interests.map((interest) => (
          <span class="interest-tag">{interest}</span>
        ))}
      </div>
    </section>

    <!-- Peer-Reviewed Publications -->
    <section class="content-section">
      <div class="section-header-row">
        <h2 class="section-heading">Selected Publications</h2>
        <span class="section-counter">{cv.publications.length} peer-reviewed articles</span>
      </div>
      <p class="section-intro-text">
        Articles covering indoor localization, wireless sensing, sensor fusion SLAM, and network optimization.
      </p>

      <ol class="publications-list">
        {cv.publications.map((paper, index) => (
          <li class="pub-entry">
            <div class="pub-main-content">
              <h3 class="pub-title">
                <a href={paper.url} target="_blank" rel="noreferrer">
                  {paper.title}
                </a>
              </h3>

              <div class="pub-authors" set:html={highlightAuthor(paper.authors)} />

              <div class="pub-meta">
                <span class="venue-name">{paper.venue}</span>
                <span class="meta-dot">·</span>
                <span class="pub-year">{paper.year}</span>
                <span class="meta-dot">·</span>
                <span class="badge-type">{paper.type}</span>
                <span class="meta-actions">
                  [<a href={paper.url} target="_blank" rel="noreferrer">DOI / Paper ↗</a>]
                  {paper.bibtex && (
                    <button class="bibtex-toggle-btn" type="button" aria-expanded="false">
                      [BibTeX]
                    </button>
                  )}
                </span>
              </div>

              {paper.bibtex && (
                <div class="bibtex-container hidden">
                  <div class="bibtex-header">
                    <span>BibTeX Citation</span>
                    <button class="copy-bibtex-btn" data-bibtex={paper.bibtex}>
                      Copy to Clipboard
                    </button>
                  </div>
                  <pre><code>{paper.bibtex}</code></pre>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Professional Experience -->
    <section class="content-section">
      <h2 class="section-heading">Professional Experience</h2>
      <div class="experience-list">
        {cv.experience.map((job) => (
          <article class="exp-entry">
            <div class="exp-title-row">
              <span class="exp-company-role">
                <strong>{job.company}</strong> — <span class="exp-role">{job.role}</span>
              </span>
              <span class="exp-period">{job.period}</span>
            </div>
            <p class="exp-summary-text">{job.summary}</p>
            <ul class="exp-bullet-list">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- Sponsored R&D & Systems -->
    <section class="content-section">
      <h2 class="section-heading">Sponsored Research & Deployment</h2>
      <div class="grants-list">
        {cv.sponsoredResearch.featured.map((grant) => (
          <div class="grant-row">
            <div class="grant-title-line">
              <span class="grant-name">
                {grant.url ? (
                  <a href={grant.url} target="_blank" rel="noreferrer">{grant.title} ↗</a>
                ) : (
                  grant.title
                )}
              </span>
              <span class="grant-meta-sub">{grant.sponsor} ({grant.period})</span>
            </div>
            <p class="grant-role-tag">{grant.role}</p>
            <p class="grant-body-desc">{grant.description}</p>
          </div>
        ))}
      </div>

      <div class="additional-grants-block">
        <h4 class="sub-heading">Additional Sponsored Contracts</h4>
        <ul class="bullet-list-simple">
          {cv.sponsoredResearch.additional.map((item) => (
            <li>
              <strong>{item.title}</strong> — <span class="muted">{item.sponsor} ({item.period})</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Education -->
    <section class="content-section">
      <h2 class="section-heading">Education</h2>
      <div class="education-grid">
        {cv.education.map((edu) => (
          <div class="edu-card">
            <div class="edu-header">
              <span class="edu-school-name"><strong>{edu.school}</strong> · {edu.degree}</span>
              <span class="edu-years">{edu.period}</span>
            </div>
            {edu.detail && <p class="edu-advisor-text">{edu.detail}</p>}
            <p class="edu-focus-text">{edu.focus}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills & Tooling -->
    <section class="content-section">
      <h2 class="section-heading">Technical Competencies</h2>
      <div class="skills-wrapper">
        {cv.skills.map((group) => (
          <div class="skill-category">
            <span class="category-name">{group.label}:</span>
            <span class="category-items">{group.items.join(" · ")}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="page-footer">
      <p>© {new Date().getFullYear()} {cv.name}. Built with Astro & TypeScript. Clean academic & engineering typesetting.</p>
      <div class="footer-bottom-links">
        <a href={cv.github} target="_blank" rel="noreferrer">GitHub</a> · 
        <a href={cv.linkedin} target="_blank" rel="noreferrer">LinkedIn</a> · 
        <a href={`mailto:${cv.email}`}>Email</a> · 
        <a href="/sangjae-lee-pro-academic-cv.pdf" target="_blank">Printable PDF</a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  // Toast Utility
  function showToast(message: string) {
    const toast = document.getElementById("toast");
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add("show");
    setTimeout(() => {
      toast.classList.remove("show");
    }, 2600);
  }

  // Theme Toggle (Light / Dark)
  const themeBtn = document.getElementById("theme-toggle-btn");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    showToast(`Switched to ${isDark ? "Dark" : "Light"} mode`);
  });

  // Copy Email Button
  const copyEmailBtn = document.getElementById("copy-email-btn");
  copyEmailBtn?.addEventListener("click", () => {
    const email = copyEmailBtn.getAttribute("data-email") || "research@studiosjlee.com";
    navigator.clipboard.writeText(email).then(() => {
      showToast(`Copied to clipboard: ${email}`);
    });
  });

  // BibTeX Toggle & Copy
  document.querySelectorAll(".bibtex-toggle-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const parent = btn.closest(".pub-entry");
      const drawer = parent?.querySelector(".bibtex-container");
      if (drawer) {
        drawer.classList.toggle("hidden");
      }
    });
  });

  document.querySelectorAll(".copy-bibtex-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const bibtex = btn.getAttribute("data-bibtex") || "";
      navigator.clipboard.writeText(bibtex).then(() => {
        showToast("BibTeX copied to clipboard!");
      });
    });
  });
</script>

<style>
  /* Design Tokens & CSS Variables */
  :root {
    --bg-main: #ffffff;
    --bg-subtle: #f8fafc;
    --bg-chip: #f1f5f9;
    --border-subtle: #e2e8f0;
    --border-strong: #1e293b;

    --text-primary: #111827;
    --text-secondary: #374151;
    --text-muted: #6b7280;
    --text-accent: #0284c7;

    --link-color: #0284c7;
    --link-hover: #0369a1;

    --pulse-color: #10b981;
    --status-bg: #f0fdf4;
    --status-border: #bbf7d0;
    --status-text: #166534;

    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, Menlo, Monaco, Consolas, monospace;
  }

  /* Dark Theme Tokens (Deep Obsidian with High Readability) */
  :global(.dark) {
    --bg-main: #09090b;
    --bg-subtle: #121215;
    --bg-chip: #18181b;
    --border-subtle: #27272a;
    --border-strong: #fafafa;

    --text-primary: #f4f4f5;
    --text-secondary: #d4d4d8;
    --text-muted: #a1a1aa;
    --text-accent: #38bdf8;

    --link-color: #38bdf8;
    --link-hover: #7dd3fc;

    --pulse-color: #34d399;
    --status-bg: rgba(16, 185, 129, 0.1);
    --status-border: rgba(16, 185, 129, 0.25);
    --status-text: #6ee7b7;
  }

  /* Base Reset & Layout */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :global(body) {
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .page-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  /* Toast Notification */
  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background-color: var(--text-primary);
    color: var(--bg-main);
    padding: 0.65rem 1.15rem;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition: all 0.2s ease;
    z-index: 9999;
  }
  .toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* Top Bar */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--status-bg);
    border: 1px solid var(--status-border);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.785rem;
    color: var(--status-text);
    font-weight: 500;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--pulse-color);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--pulse-color);
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: all 0.15s ease;
  }
  .theme-toggle:hover {
    background: var(--bg-subtle);
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  /* Masthead */
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 2.25rem;
  }

  .masthead-bio {
    flex: 1;
  }

  .name {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: 0.35rem;
  }

  .ko-name {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-left: 0.35rem;
  }

  .role-affiliation {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-accent);
    margin-bottom: 0.25rem;
  }

  .headline-summary {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.45;
  }

  .intro-prose {
    font-size: 0.975rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  /* Quick links */
  .quick-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .link-btn {
    background: var(--bg-chip);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.825rem;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .link-btn:hover {
    background: var(--text-primary);
    color: var(--bg-main);
    border-color: var(--text-primary);
  }
  .link-btn.primary {
    background: var(--text-primary);
    color: var(--bg-main);
    border-color: var(--text-primary);
    font-weight: 600;
  }
  .link-btn.primary:hover {
    opacity: 0.9;
  }

  .location-tag {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-left: 0.25rem;
  }

  /* Avatar */
  .avatar-area {
    flex-shrink: 0;
  }
  .avatar-photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--border-subtle);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  /* Metrics Strip */
  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    padding: 1.25rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    margin-bottom: 3rem;
  }
  .metric-item {
    display: flex;
    flex-direction: column;
  }
  .metric-value {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-primary);
    font-family: var(--font-mono);
    line-height: 1.1;
  }
  .metric-label {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  /* Content Sections */
  .content-section {
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    border-bottom: 1.5px solid var(--border-strong);
    padding-bottom: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1.5px solid var(--border-strong);
    padding-bottom: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .section-header-row .section-heading {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .section-counter {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .section-intro-text {
    font-size: 0.925rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .prose-text {
    font-size: 0.975rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .interest-tag {
    background: var(--bg-chip);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  /* Publications */
  .publications-list {
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pub-entry {
    padding-left: 0.5rem;
  }

  .pub-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
    margin-bottom: 0.3rem;
  }
  .pub-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .pub-title a:hover {
    color: var(--link-color);
    text-decoration: underline;
  }

  .pub-authors {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }
  :global(.pub-authors .author-highlight) {
    color: var(--text-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pub-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .venue-name {
    font-weight: 600;
    color: var(--text-secondary);
    font-style: italic;
  }
  .pub-year {
    font-family: var(--font-mono);
  }
  .badge-type {
    background: var(--bg-chip);
    border: 1px solid var(--border-subtle);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    font-size: 0.725rem;
    text-transform: uppercase;
    font-weight: 600;
  }
  .meta-dot {
    color: var(--border-subtle);
  }
  .meta-actions {
    margin-left: 0.5rem;
    display: inline-flex;
    gap: 0.4rem;
  }
  .meta-actions a {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 500;
  }
  .meta-actions a:hover {
    text-decoration: underline;
  }

  .bibtex-toggle-btn {
    background: none;
    border: none;
    color: var(--link-color);
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
    padding: 0;
  }
  .bibtex-toggle-btn:hover {
    text-decoration: underline;
  }

  .bibtex-container {
    margin-top: 0.75rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.85rem;
  }
  .bibtex-container.hidden {
    display: none;
  }

  .bibtex-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }
  .copy-bibtex-btn {
    background: var(--bg-main);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .copy-bibtex-btn:hover {
    color: var(--link-color);
    border-color: var(--link-color);
  }

  .bibtex-container pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    line-height: 1.45;
    color: var(--text-secondary);
    overflow-x: auto;
  }

  /* Experience */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .exp-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.4rem;
  }
  .exp-company-role {
    font-size: 1.05rem;
    color: var(--text-primary);
  }
  .exp-role {
    font-weight: 500;
    color: var(--text-accent);
  }
  .exp-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .exp-summary-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.65rem;
  }
  .exp-bullet-list {
