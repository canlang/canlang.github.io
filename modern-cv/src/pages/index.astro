---
import Layout from "../layouts/Layout.astro";
import { cv } from "../data/cv";

const firstAuthor = cv.name;

const highlightAuthor = (authors: string[]) =>
  authors
    .map((author) => (author === firstAuthor ? `<strong>${author}</strong>` : author))
    .join(", ");
---

<Layout title={`${cv.name} | CV`} description={cv.intro}>
  <main class="page">
    <header class="masthead">
      <div class="identity">
        <p class="eyebrow">Curriculum Vitae</p>
        <h1>{cv.name}</h1>
        <p class="title">{cv.title}</p>
      </div>
      <div class="contact">
        <a href={`mailto:${cv.email}`}>{cv.email}</a>
        <a href={`tel:${cv.phone}`}>{cv.phone}</a>
        <span>{cv.location}</span>
        <a href={cv.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={cv.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="/sangjae-lee-pro-academic-cv.pdf" target="_blank" rel="noreferrer">PDF CV</a>
      </div>
    </header>

    <section class="intro">
      <p>{cv.intro}</p>
      <p>{cv.profile}</p>
    </section>

    <section class="metrics">
      {cv.metrics.map((metric) => (
        <article class="metric">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </article>
      ))}
    </section>

    <section class="layout">
      <div class="main">
        <section class="section">
          <div class="section-head">
            <p class="section-label">Experience</p>
            <h2>Professional Experience</h2>
          </div>

          {cv.experience.map((job) => (
            <article class="entry">
              <div class="entry-top">
                <div>
                  <h3>{job.role}</h3>
                  <p class="meta">{job.company}</p>
                </div>
                <span class="period">{job.period}</span>
              </div>
              <p class="summary">{job.summary}</p>
              <ul class="bullet-list">
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="section">
          <div class="section-head">
            <p class="section-label">Selected Publications</p>
            <h2>First-Author Highlights</h2>
          </div>

          {cv.publications.map((paper) => (
            <article class="entry publication">
              <div class="entry-top">
                <div>
                  <h3>
                    <a href={paper.url} target="_blank" rel="noreferrer">{paper.title}</a>
                  </h3>
                  <p class="meta">{paper.venue}</p>
                </div>
                <span class="period">{paper.year}</span>
              </div>
              <p class="copy" set:html={highlightAuthor(paper.authors)} />
            </article>
          ))}
        </section>
      </div>

      <aside class="side">
        <section class="section section-tight">
          <div class="section-head">
            <p class="section-label">Research Interests</p>
          </div>
          <ul class="plain-list">
            {cv.interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </section>

        <section class="section section-tight">
          <div class="section-head">
            <p class="section-label">Education</p>
          </div>
          {cv.education.map((item) => (
            <article class="stack-item">
              <div class="stack-top">
                <h3>{item.degree}</h3>
                <span class="period">{item.period}</span>
              </div>
              <p class="meta">{item.school}</p>
              {item.detail && <p class="copy">{item.detail}</p>}
              {item.focus && <p class="copy">{item.focus}</p>}
            </article>
          ))}
        </section>

        <section class="section section-tight">
          <div class="section-head">
            <p class="section-label">Projects</p>
          </div>
          {cv.projects.map((project) => (
            <article class="stack-item">
              <div class="stack-top">
                <h3>{project.name}</h3>
                <span class="period">{project.period}</span>
              </div>
              <p class="meta">{project.title}</p>
              <p class="copy">{project.description}</p>
              <a href={project.url} target="_blank" rel="noreferrer" class="subtle-link">
                {project.url.replace("https://", "").replace("http://", "")}
              </a>
            </article>
          ))}
        </section>

        <section class="section section-tight">
          <div class="section-head">
            <p class="section-label">Skills</p>
          </div>
          {cv.skills.map((skill) => (
            <article class="stack-item">
              <h3>{skill.label}</h3>
              <p class="copy">{skill.items.join(" · ")}</p>
            </article>
          ))}
        </section>
      </aside>
    </section>
  </main>
</Layout>

<style>
  :global(:root) {
    --bg: #f8f7f4;
    --surface: #fffdf9;
    --text: #1b2227;
    --muted: #5d6770;
    --line: #ddd8cf;
    --line-strong: #c8c1b6;
    --accent: #0f4c5c;
  }

  :global(html) {
    font-family: "IBM Plex Sans", sans-serif;
    background: var(--bg);
    color: var(--text);
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--text);
  }

  h1,
  h2 {
    font-family: "Source Serif 4", serif;
  }

  h3,
  p,
  li,
  a,
  span {
    font-family: "IBM Plex Sans", sans-serif;
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 40px 20px 72px;
  }

  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line-strong);
  }

  .eyebrow,
  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin-top: 8px;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .title {
    margin-top: 10px;
    font-size: 1rem;
    color: var(--accent);
    font-weight: 600;
  }

  .contact {
    display: grid;
    gap: 6px;
    justify-items: end;
    text-align: right;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .contact a {
    text-decoration: none;
  }

  .contact a:hover,
  .subtle-link:hover,
  .publication a:hover {
    text-decoration: underline;
  }

  .intro {
    max-width: 74ch;
    margin-top: 20px;
    display: grid;
    gap: 12px;
  }

  .intro p,
  .summary,
  .copy {
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.97rem;
  }

  .summary {
    color: var(--text);
    margin-top: 10px;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .metric {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
  }

  .metric strong {
    display: block;
    font-size: 1.2rem;
    color: var(--text);
  }

  .metric span {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.92fr);
    gap: 28px;
    margin-top: 26px;
  }

  .section {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 22px;
  }

  .section + .section {
    margin-top: 18px;
  }

  .section-tight + .section-tight {
    margin-top: 14px;
  }

  .section-head {
    margin-bottom: 14px;
  }

  h2 {
    margin-top: 4px;
    font-size: 1.28rem;
  }

  .entry + .entry,
  .stack-item + .stack-item {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .entry-top,
  .stack-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: start;
  }

  h3 {
    font-size: 0.99rem;
    line-height: 1.42;
  }

  .meta {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .period {
    white-space: nowrap;
    color: var(--muted);
    font-size: 0.81rem;
  }

  .bullet-list {
    margin: 10px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 7px;
  }

  .bullet-list li {
    color: var(--text);
    line-height: 1.56;
  }

  .plain-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 7px;
  }

  .plain-list li {
    line-height: 1.56;
  }

  .subtle-link {
    display: inline-block;
    margin-top: 8px;
    color: var(--accent);
    font-size: 0.88rem;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .layout,
    .masthead,
    .metrics {
      grid-template-columns: 1fr;
    }

    .contact {
      justify-items: start;
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .page {
      padding: 24px 14px 40px;
    }

    .section,
    .metric {
      padding: 18px;
    }

    .entry-top,
    .stack-top {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
