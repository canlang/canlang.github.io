---
import Layout from "../layouts/Layout.astro";
import { cv } from "../data/cv";

const firstAuthor = cv.name;

const highlightAuthor = (authors: string[]) =>
  authors
    .map((author) => (author === firstAuthor ? `<strong>${author}</strong>` : author))
    .join(", ");
---

<Layout title={`${cv.name} | CV`} description={cv.intro}>
  <main class="page">
    <header class="hero">
      <div class="hero-main">
        <p class="eyebrow">{cv.headline}</p>
        <h1>{cv.name}</h1>
        <p class="role">{cv.title}</p>
        <div class="summary">
          <p>{cv.intro}</p>
          <p>{cv.profile}</p>
        </div>
      </div>

      <aside class="hero-side">
        <div class="contact-block">
          <p class="block-label">Contact</p>
          <a href={`mailto:${cv.email}`}>{cv.email}</a>
          <a href={`tel:${cv.phone}`}>{cv.phone}</a>
          <span>{cv.location}</span>
        </div>

        <div class="contact-block">
          <p class="block-label">Links</p>
          <a href={cv.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={cv.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
      </aside>
    </header>

    <section class="content">
      <div class="main-column">
        <section class="section">
          <div class="section-heading">
            <p class="section-label">Experience</p>
            <h2>Professional Experience</h2>
          </div>

          {cv.experience.map((job) => (
            <article class="entry">
              <div class="entry-top">
                <div>
                  <h3>{job.role}</h3>
                  <p class="meta">{job.company}</p>
                </div>
                <span class="period">{job.period}</span>
              </div>
              <p class="copy strong-copy">{job.summary}</p>
              <ul class="bullet-list">
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="section">
          <div class="section-heading">
            <p class="section-label">Selected Publications</p>
            <h2>First-Author Highlights</h2>
          </div>

          <div class="publication-list">
            {cv.publications.map((paper) => (
              <article class="publication">
                <div class="publication-top">
                  <a href={paper.url} target="_blank" rel="noreferrer">{paper.title}</a>
                  <span class="period">{paper.year}</span>
                </div>
                <p class="meta">{paper.venue}</p>
                <p class="copy" set:html={highlightAuthor(paper.authors)} />
              </article>
            ))}
          </div>
        </section>
      </div>

      <aside class="side-column">
        <section class="section side-section">
          <div class="section-heading compact-heading">
            <p class="section-label">Research Interests</p>
          </div>
          <div class="chips">
            {cv.interests.map((interest) => <span class="chip">{interest}</span>)}
          </div>
        </section>

        <section class="section side-section">
          <div class="section-heading compact-heading">
            <p class="section-label">Education</p>
          </div>
          <div class="stack">
            {cv.education.map((item) => (
              <article class="stack-item">
                <div class="stack-top">
                  <h3>{item.degree}</h3>
                  <span class="period">{item.period}</span>
                </div>
                <p class="meta">{item.school}</p>
                {item.detail && <p class="copy">{item.detail}</p>}
                {item.focus && <p class="copy">{item.focus}</p>}
              </article>
            ))}
          </div>
        </section>

        <section class="section side-section">
          <div class="section-heading compact-heading">
            <p class="section-label">Projects</p>
          </div>
          <div class="stack">
            {cv.projects.map((project) => (
              <article class="stack-item">
                <div class="stack-top">
                  <h3>{project.name}</h3>
                  <span class="period">{project.period}</span>
                </div>
                <p class="meta">{project.title}</p>
                <p class="copy">{project.description}</p>
                <a href={project.url} target="_blank" rel="noreferrer" class="subtle-link">
                  {project.url.replace("https://", "").replace("http://", "")}
                </a>
              </article>
            ))}
          </div>
        </section>

        <section class="section side-section">
          <div class="section-heading compact-heading">
            <p class="section-label">Skills</p>
          </div>
          <div class="stack">
            {cv.skills.map((skill) => (
              <article class="stack-item">
                <h3>{skill.label}</h3>
                <p class="copy">{skill.items.join(" · ")}</p>
              </article>
            ))}
          </div>
        </section>
      </aside>
    </section>
  </main>
</Layout>

<style>
  :global(:root) {
    --bg: #f7f5f1;
    --panel: #fffdfa;
    --text: #172126;
    --muted: #5d6a72;
    --line: #e2dcd2;
    --line-strong: #c8c0b4;
    --accent: #184e57;
    --accent-soft: #70818a;
    --chip: #f1ede6;
    --shadow: 0 12px 28px rgba(25, 28, 31, 0.05);
  }

  :global(html) {
    font-family: "IBM Plex Sans", sans-serif;
    background: var(--bg);
    color: var(--text);
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(180deg, #faf8f4 0%, #f4f1eb 100%);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    color: var(--text);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 64px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(220px, 0.7fr);
    gap: 28px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line-strong);
  }

  .eyebrow,
  .section-label,
  .block-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  h1 {
    margin-top: 10px;
    font-size: clamp(2.7rem, 5vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .role {
    margin-top: 10px;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--accent);
  }

  .summary {
    margin-top: 18px;
    display: grid;
    gap: 12px;
    max-width: 70ch;
  }

  .summary p,
  .copy,
  .bullet-list li,
  .meta {
    line-height: 1.65;
  }

  .summary p,
  .copy {
    color: var(--muted);
    font-size: 0.97rem;
  }

  .strong-copy {
    color: var(--text);
  }

  .hero-side {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .contact-block {
    background: rgba(255, 253, 250, 0.76);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    box-shadow: var(--shadow);
    display: grid;
    gap: 6px;
  }

  .contact-block a,
  .subtle-link,
  .publication-top a {
    text-decoration: none;
  }

  .contact-block a:hover,
  .subtle-link:hover,
  .publication-top a:hover {
    text-decoration: underline;
  }

  .content {
    margin-top: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1.68fr) minmax(260px, 0.9fr);
    gap: 28px;
  }

  .section {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: var(--shadow);
    padding: 22px;
  }

  .section + .section {
    margin-top: 20px;
  }

  .side-section + .side-section {
    margin-top: 16px;
  }

  .section-heading {
    margin-bottom: 16px;
  }

  .compact-heading {
    margin-bottom: 12px;
  }

  h2 {
    margin-top: 5px;
    font-size: 1.2rem;
  }

  .entry + .entry,
  .publication + .publication,
  .stack-item + .stack-item {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .entry-top,
  .publication-top,
  .stack-top {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: start;
  }

  h3 {
    font-size: 0.98rem;
    line-height: 1.42;
  }

  .meta {
    margin-top: 4px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .period {
    font-size: 0.8rem;
    color: var(--accent-soft);
    white-space: nowrap;
  }

  .entry-summary {
    margin-top: 10px;
  }

  .bullet-list {
    margin: 10px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 7px;
  }

  .bullet-list li {
    color: var(--text);
  }

  .publication-top a {
    font-weight: 700;
    line-height: 1.45;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    background: var(--chip);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 0.9rem;
    color: var(--text);
  }

  .stack {
    display: grid;
  }

  .subtle-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--accent);
  }

  @media (max-width: 920px) {
    .hero,
    .content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page {
      padding: 24px 14px 40px;
    }

    .section,
    .contact-block {
      padding: 18px;
    }

    .entry-top,
    .publication-top,
    .stack-top {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
