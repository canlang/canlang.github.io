---
import Layout from "../layouts/Layout.astro";
import { cv } from "../data/cv";

const firstAuthor = cv.name;

const highlightAuthor = (authors: string[]) =>
  authors
    .map((author) => (author === firstAuthor ? `<strong>${author}</strong>` : author))
    .join(", ");
---

<Layout title={`${cv.name} | CV`} description={cv.intro}>
  <main class="page">
    <header class="masthead">
      <div class="identity">
        <p class="kicker">{cv.headline}</p>
        <h1>{cv.name}</h1>
        <p class="title">{cv.title}</p>
      </div>
      <div class="contact">
        <a href={`mailto:${cv.email}`}>{cv.email}</a>
        <a href={`tel:${cv.phone}`}>{cv.phone}</a>
        <span>{cv.location}</span>
        <a href={cv.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={cv.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </header>

    <section class="profile">
      <p>{cv.intro}</p>
      <p>{cv.profile}</p>
    </section>

    <section class="content-grid">
      <div class="main-column">
        <section class="section">
          <div class="section-header">
            <p class="section-label">Experience</p>
            <h2>Professional Experience</h2>
          </div>
          {cv.experience.map((job) => (
            <article class="entry">
              <div class="entry-top">
                <div>
                  <h3>{job.role}</h3>
                  <p class="entry-meta">{job.company}</p>
                </div>
                <span class="entry-period">{job.period}</span>
              </div>
              <p class="entry-summary">{job.summary}</p>
              <ul class="entry-list">
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="section">
          <div class="section-header">
            <p class="section-label">Selected Publications</p>
            <h2>First-Author Research Highlights</h2>
          </div>
          <div class="publication-list">
            {cv.publications.map((paper) => (
              <article class="publication">
                <div class="publication-top">
                  <a href={paper.url} target="_blank" rel="noreferrer">
                    {paper.title}
                  </a>
                  <span>{paper.year}</span>
                </div>
                <p class="entry-meta">{paper.venue}</p>
                <p class="publication-authors" set:html={highlightAuthor(paper.authors)} />
              </article>
            ))}
          </div>
        </section>
      </div>

      <aside class="side-column">
        <section class="section section-side">
          <div class="section-header">
            <p class="section-label">Research Interests</p>
          </div>
          <ul class="plain-list">
            {cv.interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </section>

        <section class="section section-side">
          <div class="section-header">
            <p class="section-label">Education</p>
          </div>
          <div class="stack">
            {cv.education.map((item) => (
              <article class="stack-entry">
                <div class="stack-top">
                  <h3>{item.degree}</h3>
                  <span>{item.period}</span>
                </div>
                <p class="entry-meta">{item.school}</p>
                {item.detail && <p class="stack-copy">{item.detail}</p>}
                {item.focus && <p class="stack-copy">{item.focus}</p>}
              </article>
            ))}
          </div>
        </section>

        <section class="section section-side">
          <div class="section-header">
            <p class="section-label">Projects</p>
          </div>
          <div class="stack">
            {cv.projects.map((project) => (
              <article class="stack-entry">
                <div class="stack-top">
                  <h3>{project.name}</h3>
                  <span>{project.period}</span>
                </div>
                <p class="entry-meta">{project.title}</p>
                <p class="stack-copy">{project.description}</p>
                <a href={project.url} target="_blank" rel="noreferrer" class="subtle-link">
                  {project.url.replace("https://", "").replace("http://", "")}
                </a>
              </article>
            ))}
          </div>
        </section>

        <section class="section section-side">
          <div class="section-header">
            <p class="section-label">Skills</p>
          </div>
          <div class="stack">
            {cv.skills.map((skill) => (
              <article class="stack-entry">
                <h3>{skill.label}</h3>
                <p class="stack-copy">{skill.items.join(" · ")}</p>
              </article>
            ))}
          </div>
        </section>
      </aside>
    </section>
  </main>
</Layout>

<style>
  :global(:root) {
    --page-bg: #f5f3ef;
    --paper: #fffdf9;
    --text: #182125;
    --muted: #5e6b73;
    --line: #d9d2c8;
    --line-strong: #b8aea2;
    --accent: #184f57;
    --accent-soft: #6e7c83;
    --shadow: 0 18px 50px rgba(28, 30, 32, 0.08);
  }

  :global(html) {
    font-family: "IBM Plex Sans", sans-serif;
    background: var(--page-bg);
    color: var(--text);
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(245, 243, 239, 0.95)),
      var(--page-bg);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    color: var(--text);
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 48px 20px 72px;
  }

  .masthead {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    padding: 0 0 24px;
    border-bottom: 1px solid var(--line-strong);
  }

  .kicker,
  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-soft);
  }

  h1 {
    font-size: clamp(2.7rem, 5vw, 4.4rem);
    line-height: 0.96;
    margin-top: 10px;
  }

  .title {
    margin-top: 10px;
    font-size: 1.08rem;
    color: var(--accent);
    font-weight: 600;
  }

  .contact {
    min-width: 280px;
    display: grid;
    gap: 7px;
    justify-items: end;
    text-align: right;
    font-size: 0.96rem;
    color: var(--muted);
  }

  .contact a {
    text-decoration: none;
  }

  .contact a:hover,
  .subtle-link:hover,
  .publication-top a:hover {
    text-decoration: underline;
  }

  .profile {
    margin-top: 24px;
    padding: 24px 0 30px;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 14px;
    max-width: 78ch;
    color: var(--muted);
    line-height: 1.72;
    font-size: 1rem;
  }

  .content-grid {
    margin-top: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(290px, 0.9fr);
    gap: 34px;
    align-items: start;
  }

  .section {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
    box-shadow: var(--shadow);
  }

  .section + .section {
    margin-top: 22px;
  }

  .section-side + .section-side {
    margin-top: 18px;
  }

  .section-header {
    margin-bottom: 16px;
  }

  h2 {
    font-size: 1.28rem;
    margin-top: 6px;
  }

  .entry + .entry,
  .publication + .publication,
  .stack-entry + .stack-entry {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .entry-top,
  .publication-top,
  .stack-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: start;
  }

  h3 {
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .entry-meta,
  .publication-authors,
  .stack-copy {
    color: var(--muted);
    line-height: 1.65;
  }

  .entry-meta {
    margin-top: 5px;
    font-size: 0.95rem;
  }

  .entry-period,
  .stack-top span,
  .publication-top span {
    font-size: 0.84rem;
    white-space: nowrap;
    color: var(--accent-soft);
  }

  .entry-summary {
    margin-top: 12px;
    color: var(--text);
    line-height: 1.65;
  }

  .entry-list {
    margin: 12px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }

  .entry-list li {
    line-height: 1.55;
    color: var(--text);
  }

  .publication-top a {
    text-decoration: none;
    font-weight: 700;
    line-height: 1.45;
  }

  .publication-authors,
  .stack-copy {
    margin-top: 8px;
  }

  .plain-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    color: var(--text);
  }

  .stack {
    display: grid;
  }

  .subtle-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.92rem;
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 920px) {
    .masthead,
    .content-grid {
      grid-template-columns: 1fr;
      display: grid;
    }

    .contact {
      justify-items: start;
      text-align: left;
      min-width: 0;
    }
  }

  @media (max-width: 640px) {
    .page {
      padding: 24px 14px 44px;
    }

    .section {
      padding: 18px;
    }

    .entry-top,
    .publication-top,
    .stack-top {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
